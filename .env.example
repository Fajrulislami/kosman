# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Contoh untuk Supabase / Neon / Local Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kostara_db?schema=public"

# Auth Secret & JWT Configuration
# Buat string acak 32+ karakter, misalnya jalankan: openssl rand -base64 32
AUTH_SECRET="super-secret-jwt-key-change-this-in-production-123456"
NEXTAUTH_URL="http://localhost:3000"

# Storage Configuration (Supabase Storage / Cloudinary)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# WhatsApp Gateway (Opsional untuk reminder tagihan)
FONNTE_TOKEN=""
