# ========================================================
# KOSTARA BACKEND CONFIGURATION
# Salin file ini menjadi .env sebelum menjalankan aplikasi
# ========================================================

# Port Server Express
PORT=5000

# URL Database Prisma
# Saat Pengujian Lokal: Gunakan SQLite
DATABASE_URL="file:./dev.db"
# Saat Pindah ke Production (PostgreSQL):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/kostara_db?schema=public"

# Keamanan JWT (Ganti dengan string acak aman di production)
JWT_SECRET="ganti-dengan-secret-key-acak-32-karakter"

# URL Frontend (CORS Whitelist)
FRONTEND_URL="http://localhost:3000"

# Google Auth Client ID (Untuk login via Google)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ========================================================
# KREDENSIAL AWAL ADMIN (SEED DATABASE)
# ========================================================
# Di lokal (Development): Biarkan nilai default ini untuk kemudahan pengujian developer.
# Di server Production (VPS): Ganti dengan password yang SANGAT KUAT & RAHASIA.
ADMIN_INITIAL_EMAIL="admin@kostara.id"
ADMIN_INITIAL_PASSWORD="adminpassword123"
